# ============================================================
# Boots'N Pots — gitignore da raiz (repo com app web + backend)
# ============================================================

# Dependências e build
node_modules/
dist/
dist-ssr/
build/

# Segredos (chaves de API) — o .env.example pode ir
.env
.env.*
!.env.example

# Backend: fotos enviadas pelo usuário (fica só no servidor XAMPP)
api/uploads/
uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / sistema
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor Android (build artifacts)
android/app/build/
android/.gradle/
android/build/
android/capacitor.settings.gradle
android/app/src/main/assets/public/
local.properties
*.keystore
*.jks
